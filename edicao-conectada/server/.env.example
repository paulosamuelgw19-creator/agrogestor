# Copy to .env. Replace values on the manager PC; never commit .env.
AGROGESTOR_DATA_DIR=./data
# Enable only in a separate pilot installation/database after taking a backup.
AGROGESTOR_V2_ENABLED=false
AGROGESTOR_BIND_HOST=127.0.0.1
AGROGESTOR_BIND_PORT=8765
AGROGESTOR_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
AGROGESTOR_TOKEN_HOURS=168
AGROGESTOR_FARM_NAME=FAZENDA_EXEMPLO
# Select local (development), firebase, or windows. The Firebase project remains available;
# Windows mode points to the separate central_license service over the private tailnet.
AGROGESTOR_LICENSE_PROVIDER=auto
AGROGESTOR_LICENSE_API_BASE=
AGROGESTOR_LICENSE_API_KEY=

# Private, per-organization key issued in the Windows central contract panel.
AGROGESTOR_CONTRACT_ORGANIZATION_KEY=
# Optional separate contracts endpoint for isolated test environments only.
# Production normally uses AGROGESTOR_LICENSE_API_BASE for both integrations.
AGROGESTOR_CONTRACT_API_BASE=
